# ================================================
# nexthappy（私版・幸福關係 App）— 環境變數
# ================================================
# 複製成 .env.local 並填入真實值（.env.local 已被 .gitignore 排除）。
#
# ⚠️ 這個檔案會進版控 —— 一律只放佔位符，絕不放真實金鑰。
#
# 本機開發的完整步驟見 docs/LOCAL-SETUP.md。
# ------------------------------------------------


# --- Supabase ---------------------------------------------------
# 私版資料在 happy schema；public schema 是公版的，兩者靠 users.nuwa_user_id 串接。

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-anon-key>

# 🚨 service_role 會繞過所有 RLS，等同資料庫最高權限。
#    絕不可出現在前端 / log / 截圖 / 版控。外洩必須立刻 reset。
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>


# --- AI ---------------------------------------------------------

# 【必填】Claude API key —— AI 對話的核心，缺了 /chat 會壞。
ANTHROPIC_API_KEY=<anthropic-api-key>

# 【選填】語音對話（OpenAI Realtime，見 src/app/api/realtime/session/route.ts）。
#         不填只有語音不能用，其餘功能正常。
OPENAI_API_KEY=<openai-api-key>
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin


# --- 登入 / Session ----------------------------------------------

# 【必填】私版 session cookie（happy_session）的簽章金鑰。
#         隨機長字串：openssl rand -base64 48
JWT_SECRET=<random-long-string>

# 【必填】與公版 SSO 的共用金鑰。
#   正式站：必須與公版 apps.sso_secret（slug='happy'）完全一致。
#   本機：簽發與驗證都在你自己機器上，自己產一把即可，不必與任何人相同。
SSO_SECRET=<sso-shared-secret>


# --- 功能開關 ----------------------------------------------------

# 額度控管：true 才會擋超量。開發階段維持 false。
BILLING_ENFORCEMENT=false


# --- 本機整合開發（正式站絕不設定）---------------------------------

# 公版站台網址。本機把公版也跑起來時，指向本機公版；
# 不設則使用正式站（見 src/lib/market.ts）。
# ⚠️ NEXT_PUBLIC_* 會在 build 時寫死進 bundle —— 設過 localhost 之後，
#    不要拿本機的 build 產物去部署。
# NEXT_PUBLIC_MARKET_BASE_URL=http://localhost:3000
